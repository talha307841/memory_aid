# MemoryAid Docker Environment Configuration
# Only the OpenAI API key is required - everything else has sensible defaults

# Required: Your OpenAI API key
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Override defaults if needed
# DEMO_MODE=true
# CAPTURE_INTERVAL_SECONDS=30
# MEMORY_API_KEY=demo_key_12345
